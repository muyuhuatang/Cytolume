# Python bytecode — regenerated by every `python -m spine.export.*` run.
__pycache__/
*.py[cod]

# dependencies / build output
node_modules/
dist/
dist-app/
.vite/

# Cytolume spine artifacts — REGENERABLE, and ~42 MB. Rebuild with:
#   cd web && python -m spine.export.build_all
web/spine/build/
web/public/spine/

# local captures and scratch
screenshots/
*.local
*.log
# Scratch drivers / captures only. NOT a blanket `_*`: that swallowed
# spine/export/__init__.py and broke `python -m spine.export.*` on a fresh clone.
# `_*.py` has the same problem (`__init__.py` matches it), hence the un-ignore.
_*.mjs
_*.png
_*.py
!**/__init__.py

# reference material fetched for design comparison — look-at-only, never shipped
.gauntlet-refs/

.DS_Store
